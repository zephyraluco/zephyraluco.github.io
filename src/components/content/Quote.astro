---
import config from '../../config/index'
import { cn } from '../../lib/class-merge'

const { class: className } = Astro.props
---

<quote-component class={cn('not-prose inline-block', className)}>
  <div class='flex flex-row items-center gap-x-3 rounded-full border px-4 py-2 text-sm shadow-sm'>
    <span class='relative flex items-center justify-center'>
      <span class='absolute size-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'></span>
      <span class='size-2 rounded-full bg-green-400'></span>
    </span>
    <p id='quote-sentence' class='font-medium text-muted-foreground'>
      {config.integ.quote.fallback}
    </p>
  </div>
</quote-component>

<script>
  import config from '../../config/client'

  const { quote } = config.integ

  class Quote extends HTMLElement {
    render(sentence: string) {
      const quoteEl = this.querySelector('#quote-sentence') as HTMLElement
      if (!quoteEl) return
      quoteEl.innerText = sentence
    }

    private controller?: AbortController

    async connectedCallback() {
      this.controller = new AbortController()
      try {
        const response = await fetch(quote.server, { signal: this.controller.signal })
        if (!response.ok) throw new Error(`Quote request failed: ${response.status}`)
        this.render(quote.target(await response.json()))
      } catch {
        if (!this.controller.signal.aborted)
          this.render(quote.fallback ?? 'Stay hungry, stay foolish')
      }
    }

    disconnectedCallback() {
      this.controller?.abort()
    }
  }
  if (!customElements.get('quote-component')) customElements.define('quote-component', Quote)
</script>
