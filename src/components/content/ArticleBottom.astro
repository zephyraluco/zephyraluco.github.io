---
import type { CollectionEntry, CollectionKey } from 'astro:content'

import { cn } from '../../lib/class-merge'

type Props = {
  id: string
  collections: CollectionEntry<CollectionKey>[]
  class?: string
}

// Get the requested entry
const { id, collections, class: className } = Astro.props
const path = Astro.url.pathname.split('/').slice(0, 2).join('/')

// Get the next and prev entries (modulo to wrap index)
const index = collections.findIndex((x) => x.id === id)
const prev = collections[index - 1]
const next = collections[index + 1]
---

<div class={cn('flex max-sm:flex-col sm:justify-between gap-2', className)}>
  <span class='min-w-0'>
    {prev && (
      <a
        href={`${path}/${prev.id}`}
        class='post-nav-item group inline-flex items-center gap-x-2 rounded-xl px-4 py-2 no-underline max-sm:max-w-[80%] sm:flex'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='20'
          height='20'
          viewBox='0 0 24 24'
          fill='none'
          stroke-width='2.5'
          stroke-linecap='round'
          stroke-linejoin='round'
          class='shrink-0 rotate-180 stroke-muted-foreground transition-colors group-hover:stroke-primary'
        >
          <line
            x1='5'
            y1='12'
            x2='19'
            y2='12'
            class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100'
          />
          <polyline
            points='12 5 19 12 12 19'
            class='translate-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1'
          />
        </svg>
        <p class='truncate font-medium transition-colors'>{prev.data.title}</p>
      </a>
    )}
  </span>

  <span class='min-w-0'>
    {next && (
      <a
        href={`${path}/${next.id}`}
        class='post-nav-item group inline-flex items-center gap-x-2 rounded-xl px-4 py-2 text-right no-underline max-sm:float-end max-sm:max-w-[80%] sm:flex'
      >
        <p class='truncate font-medium transition-colors'>{next.data.title}</p>
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='20'
          height='20'
          viewBox='0 0 24 24'
          fill='none'
          stroke-width='2.5'
          stroke-linecap='round'
          stroke-linejoin='round'
          class='shrink-0 stroke-muted-foreground transition-colors group-hover:stroke-primary'
        >
          <line
            x1='5'
            y1='12'
            x2='19'
            y2='12'
            class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100'
          />
          <polyline
            points='12 5 19 12 12 19'
            class='translate-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1'
          />
        </svg>
      </a>
    )}
  </span>
</div>

<style>
  .post-nav-item {
    transition:
      background-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }
  .post-nav-item:hover {
    background: hsl(var(--muted));
    box-shadow: inset 0 0.0625rem 0 rgb(255 255 255 / 0.1);
  }
  .post-nav-item:active {
    transform: scale(0.9);
  }
  .post-nav-item:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .post-nav-item,
    .post-nav-item svg,
    .post-nav-item svg * {
      transition: none;
    }
    .post-nav-item:active {
      transform: none;
    }
  }
</style>
