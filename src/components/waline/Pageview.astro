<pageview-counter hidden></pageview-counter>

<script>
  import { pageviewCount } from '@waline/client/pageview'

  import config from '../../config/client'

  class PageviewCounter extends HTMLElement {
    connectedCallback() {
      if (import.meta.env.DEV || !config.integ.waline.enable || !config.integ.waline.server) return
      pageviewCount({ serverURL: config.integ.waline.server, path: window.location.pathname })
    }
  }
  if (!customElements.get('pageview-counter'))
    customElements.define('pageview-counter', PageviewCounter)
</script>
