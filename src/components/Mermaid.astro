---
// Mermaid client renderer with zoom / pan support.
// Place <Mermaid /> once in layouts that render markdown content
// (e.g. BlogPost, IndividualPage, CommonPage).
// It scans the page for `<div class="mermaid">` blocks produced by the
// rehype-mermaid plugin and renders them with the mermaid library.
---

<mermaid-renderer></mermaid-renderer>

<script>
  type MermaidApi = {
    initialize: (config: Record<string, unknown>) => void
    run: (opts: { nodes: Iterable<HTMLElement> }) => Promise<void>
  }

  class MermaidRenderer extends HTMLElement {
    private mermaid: MermaidApi | null = null
    private initialized = false
    private lastTheme: 'dark' | 'light' | undefined

    private currentTheme(): 'dark' | 'light' {
      return document.documentElement.classList.contains('dark')
        ? 'dark'
        : 'light'
    }

    private async loadMermaid(): Promise<MermaidApi> {
      if (this.mermaid) return this.mermaid
      const mod = await import('mermaid')
      this.mermaid = (mod.default ?? mod) as unknown as MermaidApi
      return this.mermaid
    }

    private async renderAll() {
      const nodes = Array.from(
        document.querySelectorAll<HTMLElement>('div.mermaid')
      )
      if (nodes.length === 0) return

      const mermaid = await this.loadMermaid()
      const theme = this.currentTheme()

      if (!this.initialized || this.lastTheme !== theme) {
        mermaid.initialize({
          startOnLoad: false,
          theme: theme === 'dark' ? 'dark' : 'default',
          securityLevel: 'loose',
          fontFamily: 'inherit'
        })
        this.initialized = true
        this.lastTheme = theme
      }

      // Reset previously rendered content so mermaid can re-parse.
      for (const node of nodes) {
        if (node.dataset.rendered === 'true') {
          node.removeAttribute('data-processed')
          // Restore original mermaid source code saved on first render.
          node.innerHTML = node.dataset.mermaidCode ?? node.textContent ?? ''
        }
        // Save mermaid source before mermaid.run() overwrites innerHTML.
        if (!node.dataset.mermaidCode) {
          node.dataset.mermaidCode = node.textContent ?? ''
        }
      }

      try {
        await mermaid.run({ nodes })
        for (const node of nodes) {
          node.dataset.rendered = 'true'
          this.setupZoomPan(node)
        }
      } catch (err) {
        console.error('Mermaid render error:', err)
      }
    }

    // ------------------------------------------------------------------
    // Zoom / Pan – per-diagram interactive viewport
    // ------------------------------------------------------------------
    private setupZoomPan(container: HTMLElement) {
      // Idempotent – don't double-wrap.
      if (container.querySelector('.mermaid-interactive')) return

      const svg = container.querySelector('svg')
      if (!svg) return

      // --- build wrapper DOM ---
      const interactive = document.createElement('div')
      interactive.className = 'mermaid-interactive'

      const viewport = document.createElement('div')
      viewport.className = 'mermaid-viewport'
      viewport.appendChild(svg)

      const controls = document.createElement('div')
      controls.className = 'mermaid-controls'
      controls.innerHTML = `
        <button class="mermaid-ctrl zoom-toggle" title="缩放/移动" aria-label="缩放/移动">⤢</button>
        <button class="mermaid-ctrl zoom-in" title="放大" aria-label="放大">+</button>
        <button class="mermaid-ctrl zoom-out" title="缩小" aria-label="缩小">−</button>
        <button class="mermaid-ctrl zoom-reset" title="重置" aria-label="重置">↺</button>
      `
      interactive.appendChild(viewport)
      interactive.appendChild(controls)
      container.appendChild(interactive)

      // --- per-instance state ---
      let scale = 1
      let tx = 0
      let ty = 0
      let panning = false
      let lastX = 0
      let lastY = 0

      // Interactive mode is OFF by default – the diagram stays static so it
      // cannot be grabbed/zoomed accidentally. Clicking the toggle button
      // enables wheel-zoom and drag/pinch panning.
      let interactEnabled = false

      // pinch-zoom state
      let pinchStartDist = 0
      let pinchStartScale = 1

      const MIN = 0.25
      const MAX = 5
      const STEP = 0.15

      const clamp = (v: number) => Math.min(MAX, Math.max(MIN, v))

      // Original viewBox – zoom is applied by re-rendering the SVG through its
      // viewBox (vector re-render, always sharp at any zoom level), while pan
      // uses a cheap CSS translate on the compositor.
      const vb = svg.viewBox.baseVal
      if (!vb || vb.width === 0 || vb.height === 0) return
      const vbX = vb.x
      const vbY = vb.y
      const vbW = vb.width
      const vbH = vb.height

      // Fix the viewport and the SVG element to their initial rendered size so
      // `overflow: hidden` actually clips the zoomed content; panning can then
      // reveal the previously clipped regions.
      const baseW = svg.getBoundingClientRect().width
      const baseH = svg.getBoundingClientRect().height
      viewport.style.width = `${baseW}px`
      viewport.style.height = `${baseH}px`
      svg.style.width = `${baseW}px`
      svg.style.height = `${baseH}px`
      svg.style.maxWidth = 'none'

      const clampT = (v: number, max: number) =>
        Math.min(max, Math.max(-max, v))

      // Current viewBox origin. Zoom is anchored at the *viewport centre*:
      // the content point currently under the visible centre (pan offset
      // included) stays fixed while the viewBox is re-sized around it.
      let vx = vbX
      let vy = vbY

      // Max pan offset for a given scale. Must never be negative: when the
      // content is smaller than the viewport (scale <= 1) there is nothing to
      // pan, so the bound is 0 – a negative bound would flip the clamp and
      // shove the content towards the top-left on every zoom-out.
      const maxPan = (size: number, s: number) =>
        Math.max(0, (size * (s - 1)) / 2)

      const apply = () => {
        svg.setAttribute('viewBox', `${vx} ${vy} ${vbW / scale} ${vbH / scale}`)
        // keep the pan inside the zoomed content bounds
        tx = clampT(tx, maxPan(baseW, scale))
        ty = clampT(ty, maxPan(baseH, scale))
        svg.style.transform = `translate(${tx}px, ${ty}px)`
      }

      // Zoom by `factor`, keeping the content point under the current
      // viewport centre fixed (i.e. zoom around the visible centre).
      const zoomAt = (factor: number) => {
        const next = clamp(factor)
        if (next === scale) return
        // content point currently under the viewport centre, computed from
        // the *actual* on-screen pan (before clamping) so the anchor matches
        // what the user is really looking at
        const vw = vbW / scale
        const vh = vbH / scale
        const anchorX = vx + ((baseW / 2 - tx) / baseW) * vw
        const anchorY = vy + ((baseH / 2 - ty) / baseH) * vh
        // clamp pan to the new bounds (0 when shrinking below 1×)
        tx = clampT(tx, maxPan(baseW, next))
        ty = clampT(ty, maxPan(baseH, next))
        scale = next
        const nw = vbW / scale
        const nh = vbH / scale
        // re-position the viewBox so that same content point stays centred
        vx = anchorX - ((baseW / 2 - tx) / baseW) * nw
        vy = anchorY - ((baseH / 2 - ty) / baseH) * nh
        apply()
      }

      const resetView = () => {
        scale = 1
        tx = 0
        ty = 0
        vx = vbX
        vy = vbY
        apply()
      }

      // --- wheel zoom (only in interactive mode) ---
      viewport.addEventListener('wheel', (e) => {
        if (!interactEnabled) return
        e.preventDefault()
        zoomAt(scale + (e.deltaY < 0 ? STEP : -STEP))
      }, { passive: false })

      // --- pointer / touch pan (only in interactive mode) ---
      const onDown = (cx: number, cy: number) => {
        panning = true
        lastX = cx
        lastY = cy
        viewport.style.cursor = 'grabbing'
        svg.style.userSelect = 'none'
      }

      viewport.addEventListener('mousedown', (e) => {
        if (!interactEnabled || e.button !== 0) return
        onDown(e.clientX, e.clientY)
      })

      viewport.addEventListener('touchstart', (e) => {
        if (!interactEnabled) return
        if (e.touches.length === 1) {
          onDown(e.touches[0].clientX, e.touches[0].clientY)
        } else if (e.touches.length === 2) {
          // begin pinch
          panning = false
          pinchStartDist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          )
          pinchStartScale = scale
        }
      }, { passive: true })

      const onMove = (cx: number, cy: number) => {
        if (!panning) return
        tx += cx - lastX
        ty += cy - lastY
        lastX = cx
        lastY = cy
        apply()
      }

      window.addEventListener('mousemove', (e) => onMove(e.clientX, e.clientY))
      window.addEventListener('touchmove', (e) => {
        if (!interactEnabled) return
        if (e.touches.length === 2) {
          // pinch zoom – anchored at the viewport centre
          const dist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          )
          zoomAt(pinchStartScale * (dist / pinchStartDist))
        } else if (e.touches.length === 1) {
          onMove(e.touches[0].clientX, e.touches[0].clientY)
        }
      }, { passive: true })

      const onUp = () => {
        panning = false
        viewport.style.cursor = interactEnabled ? 'grab' : ''
        svg.style.userSelect = ''
      }

      window.addEventListener('mouseup', onUp)
      window.addEventListener('touchend', onUp)

      // --- double-click reset (only in interactive mode) ---
      viewport.addEventListener('dblclick', () => {
        if (!interactEnabled) return
        resetView()
      })

      // --- interactive-mode toggle ---
      const toggleBtn = interactive.querySelector(
        '.zoom-toggle'
      ) as HTMLButtonElement
      const setInteractive = (on: boolean) => {
        interactEnabled = on
        toggleBtn.classList.toggle('active', on)
        viewport.style.cursor = on ? 'grab' : ''
        if (!on) {
          panning = false
          svg.style.userSelect = ''
        }
      }
      toggleBtn.addEventListener('click', () => setInteractive(!interactEnabled))

      // --- control buttons ---
      interactive.querySelector('.zoom-in')!.addEventListener('click', () => {
        zoomAt(scale + STEP * 2)
      })
      interactive.querySelector('.zoom-out')!.addEventListener('click', () => {
        zoomAt(scale - STEP * 2)
      })
      interactive.querySelector('.zoom-reset')!.addEventListener('click', () => {
        resetView()
      })

      // --- prevent native image drag on the SVG ---
      svg.addEventListener('dragstart', (e) => e.preventDefault())

      apply()
    }

    connectedCallback() {
      const run = () => this.renderAll()
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run, { once: true })
      } else {
        run()
      }

      // Re-render when theme changes.
      const observer = new MutationObserver((mutations) => {
        for (const m of mutations) {
          if (m.attributeName === 'class') {
            const theme = this.currentTheme()
            if (theme !== this.lastTheme) run()
            break
          }
        }
      })
      observer.observe(document.documentElement, { attributes: true })
    }
  }

  customElements.define('mermaid-renderer', MermaidRenderer)
</script>

<style is:global>
  /* Host container – simple centering, overflow handled by viewport. */
  .mermaid {
    display: flex;
    justify-content: center;
    margin: 1.5rem 0;
    text-align: center;
  }

  /* Interactive wrapper – full-width so SVG can use all available space. */
  .mermaid-interactive {
    position: relative;
    display: block;
    width: 100%;
  }

  /* Clipped viewport – the pan/zoom canvas. Size is fixed by JS to the
     initial SVG size so overflow can actually clip the zoomed content.
     No cursor by default – grab cursor is applied via JS only when
     interactive mode (zoom/pan) is enabled. */
  .mermaid-viewport {
    overflow: hidden;
    position: relative;
    margin: 0 auto;
  }

  .mermaid-viewport svg {
    display: block;
    /* zoom re-renders the SVG via viewBox, so it stays sharp;
       disable transitions so zoom/pan feels instant */
    transition: none;
    /* let zoomed content draw outside the SVG box so panning can reveal it */
    overflow: visible;
  }

  /* Floating zoom controls – shown on hover, top-right corner. */
  .mermaid-controls {
    position: absolute;
    top: 6px;
    right: 6px;
    display: flex;
    gap: 4px;
    opacity: 0;
    transition: opacity 0.2s;
    z-index: 10;
  }

  .mermaid-interactive:hover .mermaid-controls,
  .mermaid-interactive:focus-within .mermaid-controls {
    opacity: 1;
  }

  .mermaid-ctrl {
    width: 28px;
    height: 28px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    background: #fff;
    color: #374151;
    font-size: 15px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    padding: 0;
    transition: background 0.15s, border-color 0.15s;
  }

  .mermaid-ctrl:hover {
    background: #f3f4f6;
    border-color: #9ca3af;
  }

  /* Toggle button – highlighted while interactive mode is on. */
  .mermaid-ctrl.zoom-toggle.active {
    background: #2563eb;
    border-color: #2563eb;
    color: #fff;
  }

  .mermaid-ctrl.zoom-toggle.active:hover {
    background: #1d4ed8;
  }

  :global(.dark) .mermaid-ctrl {
    background: #1f2937;
    color: #d1d5db;
    border-color: #4b5563;
  }

  :global(.dark) .mermaid-ctrl:hover {
    background: #374151;
    border-color: #6b7280;
  }
</style>
