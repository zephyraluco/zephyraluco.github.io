---
import config from '@/site-config'

import Icon from './ui/Icon.astro'

const menuItems = config.header.menu ?? []
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const isCurrent = (link: string) => pathname === link || pathname.startsWith(`${link}/`)
---

<site-header>
  <nav aria-label='Main navigation' class='navigation'>
    <a class='skip-link' href='#main-content'>
      Skip to main content
    </a>
    <a class='brand' href='/' aria-current={pathname === '/' ? 'page' : undefined}>
      <svg
        viewBox='0 0 24 24'
        fill='none'
        stroke='currentColor'
        stroke-width='2'
        aria-hidden='true'
      >
        <path
          d='m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-8H9v8H4a1 1 0 0 1-1-1Z'
          stroke-linejoin='round'
        />
      </svg>
      <span>{config.title}</span>
    </a>
    <span class='divider' aria-hidden='true'></span>
    <div class='nav-links'>
      {menuItems.map(({ title, link }) => (
        <a href={link} aria-current={isCurrent(link) ? 'page' : undefined} data-astro-prefetch>
          {title}
        </a>
      ))}
    </div>
    <div class='actions'>
      <a
        class='icon-button'
        href='/search'
        aria-label='Search'
        title='Search'
        aria-current={pathname === '/search' ? 'page' : undefined}
      >
        <Icon name='search' />
      </a>
      <div class='theme-switcher'>
        <button
          class='icon-button theme-toggle'
          type='button'
          aria-label='Color theme: system'
          aria-expanded='false'
          aria-controls='theme-options'
        >
          <span data-theme-icon='light'>
            <svg
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <circle cx='12' cy='12' r='4' />
              <path d='M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5' />
            </svg>
          </span>
          <span data-theme-icon='dark'>
            <svg
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <path d='M20.5 13A9 9 0 0 1 11 3.5 9 9 0 1 0 20.5 13Z' />
            </svg>
          </span>
          <span data-theme-icon='system'>
            <svg
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <circle cx='12' cy='12' r='9' />
              <path d='M12 3a9 9 0 0 1 0 18Z' fill='currentColor' />
            </svg>
          </span>
        </button>
        <div id='theme-options' class='theme-options' role='group' aria-label='Color theme' hidden>
          <button
            class='icon-button'
            type='button'
            data-theme='light'
            aria-label='Light theme'
            title='Light theme'
            aria-pressed='false'
          >
            <svg
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <circle cx='12' cy='12' r='4' />
              <path d='M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5' />
            </svg>
          </button>
          <button
            class='icon-button'
            type='button'
            data-theme='dark'
            aria-label='Dark theme'
            title='Dark theme'
            aria-pressed='false'
          >
            <svg
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <path d='M20.5 13A9 9 0 0 1 11 3.5 9 9 0 1 0 20.5 13Z' />
            </svg>
          </button>
          <button
            class='icon-button'
            type='button'
            data-theme='system'
            aria-label='System theme'
            title='System theme'
            aria-pressed='false'
          >
            <svg
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <circle cx='12' cy='12' r='9' />
              <path d='M12 3a9 9 0 0 1 0 18Z' fill='currentColor' />
            </svg>
          </button>
        </div>
      </div>
      <a
        class='icon-button secondary-action'
        href='https://github.com/zephyraluco/zephyraluco.github.io'
        aria-label='Source on GitHub'
        title='Source on GitHub'
      >
        <Icon name='github' />
      </a>
    </div>
    <details class='mobile-menu'>
      <summary class='icon-button' aria-label='Navigation menu' title='Navigation menu'>
        <Icon name='menu' />
      </summary>
      <div class='mobile-links'>
        {menuItems.map(({ title, link }) => (
          <a href={link} aria-current={isCurrent(link) ? 'page' : undefined}>
            {title}
          </a>
        ))}
        <a href='https://github.com/zephyraluco/zephyraluco.github.io'>GitHub</a>
      </div>
    </details>
  </nav>
</site-header>

<script>
  import { getTheme, setTheme, type ColorTheme } from '../lib/theme'

  class SiteHeader extends HTMLElement {
    private controller?: AbortController

    connectedCallback() {
      this.controller = new AbortController()
      const { signal } = this.controller
      const themeButton = this.querySelector<HTMLButtonElement>('.theme-toggle')
      const options = this.querySelector<HTMLElement>('.theme-options')!
      const choices = Array.from(options.querySelectorAll<HTMLButtonElement>('[data-theme]'))
      const closeTheme = (focus = false) => {
        options.hidden = true
        themeButton?.setAttribute('aria-expanded', 'false')
        if (focus) themeButton?.focus()
      }
      const updateThemeLabel = () => {
        const theme = getTheme()
        themeButton?.setAttribute('aria-label', `Color theme: ${theme}`)
        themeButton?.setAttribute('title', `Color theme: ${theme}`)
        choices.forEach((button) =>
          button.setAttribute('aria-pressed', String(button.dataset.theme === theme))
        )
      }
      updateThemeLabel()
      themeButton?.addEventListener(
        'click',
        () => {
          options.hidden = !options.hidden
          themeButton.setAttribute('aria-expanded', String(!options.hidden))
          if (!options.hidden) {
            const mobile = this.querySelector<HTMLDetailsElement>('.mobile-menu')
            if (mobile) mobile.open = false
          }
        },
        { signal }
      )
      choices.forEach((button) =>
        button.addEventListener(
          'click',
          () => {
            setTheme(button.dataset.theme as ColorTheme, true)
            updateThemeLabel()
            closeTheme(true)
          },
          { signal }
        )
      )
      options.addEventListener(
        'keydown',
        (event) => {
          const index = choices.indexOf(document.activeElement as HTMLButtonElement)
          let next: number | undefined
          if (event.key === 'ArrowRight') next = (index + 1) % choices.length
          if (event.key === 'ArrowLeft') next = (index + choices.length - 1) % choices.length
          if (event.key === 'Home') next = 0
          if (event.key === 'End') next = choices.length - 1
          if (next !== undefined) {
            event.preventDefault()
            choices[next].focus()
          }
        },
        { signal }
      )
      themeButton?.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'ArrowDown') {
            event.preventDefault()
            options.hidden = false
            themeButton.setAttribute('aria-expanded', 'true')
            choices.find((button) => button.getAttribute('aria-pressed') === 'true')?.focus()
          }
        },
        { signal }
      )
      document.addEventListener(
        'click',
        (event) => {
          if (
            event.target instanceof Node &&
            !this.querySelector('.theme-switcher')?.contains(event.target)
          )
            closeTheme()
        },
        { signal }
      )
      this.addEventListener(
        'focusout',
        (event) => {
          if (
            !(event.relatedTarget instanceof Node) ||
            !this.querySelector('.theme-switcher')?.contains(event.relatedTarget)
          )
            closeTheme()
        },
        { signal }
      )
      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape' && !options.hidden) closeTheme(true)
        },
        { signal }
      )
      window.addEventListener('storage', updateThemeLabel, { signal })

      const menu = this.querySelector<HTMLDetailsElement>('.mobile-menu')
      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape' && menu?.open) {
            menu.open = false
            menu.querySelector('summary')?.focus()
          }
        },
        { signal }
      )
      document.addEventListener(
        'click',
        (event) => {
          if (event.target instanceof Node && !this.contains(event.target) && menu)
            menu.open = false
        },
        { signal }
      )
    }

    disconnectedCallback() {
      this.controller?.abort()
    }
  }

  if (!customElements.get('site-header')) customElements.define('site-header', SiteHeader)
</script>

<style>
  site-header {
    --nav-glass: hsl(var(--muted) / 0.7);
    --nav-text: hsl(var(--foreground));
    --nav-hover: hsl(var(--foreground) / 0.05);
    --nav-edge: inset 0 0.0625rem 0 rgb(255 255 255 / 0.1);
    --nav-shadow: 0 0.75rem 1.5rem -1rem rgb(0 0 0 / 0.5);
    display: block;
    position: sticky;
    top: max(0.75rem, env(safe-area-inset-top));
    z-index: 50;
    /* Keep the centered shell stable while the web font loads. */
    width: 36rem;
    max-width: 100%;
    margin: 1rem auto 3rem;
  }
  .navigation {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    width: 100%;
    padding: 0.35rem 0.5rem;
    border-radius: 999px;
    font-size: 1rem;
    color: var(--nav-text);
  }
  .navigation::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: var(--nav-glass);
    -webkit-backdrop-filter: saturate(1.8) blur(0.75rem);
    backdrop-filter: saturate(1.8) blur(0.75rem);
    box-shadow: var(--nav-edge), var(--nav-shadow);
    pointer-events: none;
  }
  .navigation :is(a, button, summary) {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 0.625rem 0.75rem;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 500;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 150ms,
      color 150ms,
      transform 150ms,
      box-shadow 150ms;
  }
  .navigation :is(a, button, summary):hover {
    background: var(--nav-hover);
    color: hsl(var(--primary));
    box-shadow: var(--nav-edge);
  }
  .navigation :is(a, button, summary):active {
    transform: scale(0.9);
  }
  .navigation :is(a, button, summary):focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
  }
  .navigation a[aria-current='page'] {
    background: hsl(var(--primary) / 0.1);
    color: hsl(var(--primary));
    box-shadow: var(--nav-edge);
  }
  .navigation .brand {
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    font-size: 1rem;
    font-weight: 550;
    color: var(--nav-text);
    white-space: nowrap;
  }
  .navigation .brand[aria-current='page'] {
    color: hsl(var(--primary));
  }
  .brand svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  .divider {
    align-self: stretch;
    width: max(1px, 0.0625em);
    margin: 0.2rem 0.45rem;
    background: hsl(var(--foreground) / 0.1);
  }
  .nav-links,
  .actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .nav-links {
    flex: 1;
    justify-content: space-evenly;
    gap: 0.15rem;
  }
  .actions {
    gap: 0.1rem;
    margin-inline-start: 0.35rem;
  }
  .nav-links a {
    padding: 0.45rem 0.65rem;
  }
  .nav-links a,
  .mobile-links a {
    font-size: 1rem;
    font-weight: 500;
  }
  .navigation .icon-button {
    width: 2.15rem;
    height: 2.15rem;
    padding: 0.45rem;
  }
  .icon-button :global(svg) {
    flex-shrink: 0;
    width: 1.15rem;
    height: 1.15rem;
  }
  .navigation .theme-toggle:hover,
  .navigation .theme-toggle[aria-expanded='true'] {
    background: var(--nav-hover);
    color: hsl(var(--primary));
    box-shadow: var(--nav-edge);
  }
  .theme-switcher {
    position: relative;
  }
  .theme-options {
    position: absolute;
    top: calc(100% + 1rem);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 999px;
    background: var(--nav-glass);
    -webkit-backdrop-filter: saturate(1.8) blur(0.75rem);
    backdrop-filter: saturate(1.8) blur(0.75rem);
    box-shadow: var(--nav-edge), var(--nav-shadow);
  }
  .theme-options[hidden],
  [data-theme-icon] {
    display: none;
  }
  :global(html[data-theme-preference='light']) [data-theme-icon='light'],
  :global(html[data-theme-preference='dark']) [data-theme-icon='dark'],
  :global(html[data-theme-preference='system']) [data-theme-icon='system'],
  :global(html:not([data-theme-preference])) [data-theme-icon='system'] {
    display: flex;
  }
  .navigation .theme-options button[aria-pressed='true'] {
    color: hsl(var(--primary));
    background: hsl(var(--primary) / 0.1);
    box-shadow: var(--nav-edge);
  }
  .mobile-menu {
    display: none;
  }
  summary {
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .navigation .skip-link {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    opacity: 0;
    pointer-events: none;
    white-space: nowrap;
  }
  .navigation .skip-link:focus {
    top: calc(100% + 0.5rem);
    opacity: 1;
    pointer-events: auto;
    background: var(--nav-glass);
    backdrop-filter: saturate(1.8) blur(0.75rem);
    box-shadow: var(--nav-edge), var(--nav-shadow);
  }
  @media (max-width: 720px) {
    site-header {
      width: 18rem;
    }
    .actions {
      margin-inline-start: auto;
    }
    .navigation .nav-links,
    .navigation .divider,
    .navigation .secondary-action {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .mobile-links {
      position: absolute;
      inset-inline: 0;
      top: calc(100% + 0.5rem);
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0.5rem;
      border-radius: 1.625rem;
      background: var(--nav-glass);
      -webkit-backdrop-filter: saturate(1.8) blur(0.75rem);
      backdrop-filter: saturate(1.8) blur(0.75rem);
      box-shadow: var(--nav-edge), var(--nav-shadow);
    }
    .mobile-links a {
      min-height: 2.75rem;
    }
  }
  @media (max-width: 540px) {
    .navigation {
      gap: 0.1rem;
      padding: 0.3rem;
    }
    .navigation .brand {
      gap: 0.35rem;
      padding: 0.35rem 0.5rem;
    }
    .navigation .icon-button {
      width: 2rem;
      height: 2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .navigation :is(a, button, summary) {
      transition: none;
    }
  }
</style>
