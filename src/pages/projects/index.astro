---
import { Image } from 'astro:assets'

import { Button, Collapse, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Sponsors from '@/components/projects/Sponsors.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
import KeyIcon from '@/assets/icons/key.svg'

const headings = [
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'learnings', text: 'Learnings' }
]
---

<PageLayout title='Projects' {headings} view>
  {/* About astro-pure */}
  <!-- <div class='not-prose flex justify-center'>
    <a
      href='/docs/advanced/about' target='_blank'
      class='flex items-center gap-x-3 rounded-full border bg-background px-4 py-2 text-sm shadow-sm transition-shadow hover:shadow-md'
    >
      <span class='size-2 rounded-full bg-green-400'></span>
      <p class='font-medium text-muted-foreground'>About Astro-Theme-Pure Project</p>
    </a>
  </div> -->
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/zephyraluco'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>
  <!-- <p>
    If you think it would be useful or interesting to collaborate on a project, you can donate to
    support my work or contact me to discuss a project.
  </p>
  <Button title='Checkout sponsorship' class='w-fit' href='#sponsorship'>
    <Icon class='size-5' name='receive-money' slot='before' />
  </Button> -->

  <h2 id='programs'>Programs</h2>
  <ProjectSection
    projects={[
      {
        name: 'zenrc',
        description: 'A shared memory based robot core',
        links: [
          { type: 'github', href: 'https://github.com/zephyraluco/zenrc' },
          { type: 'site', href: 'https://github.com/zephyraluco/zenrc' },
          { type: 'doc', href: 'https://github.com/zephyraluco/zenrc' },
          // { type: 'release', href: 'https://www.npmjs.com/package/astro-pure' }
        ]
      },
      {
        name: 'alacrterm',
        description: '一个基于 Alacritty 和 GPUI 的终端模拟器',
        links: [
          { type: 'github', href: 'https://github.com/zephyraluco/alacrterm' },
          { type: 'site', href: 'https://github.com/zephyraluco/alacrterm' },
          { type: 'doc', href: 'https://github.com/zephyraluco/alacrterm' }
        ]
      }
    ]}
  />
  <Collapse title='Some old projects'>
    <ProjectSection
      projects={[
        {
          name: 'olei_driver',
          description: '从OLEI官方ros驱动拆分出的SDK',
          links: [
            { type: 'github', href: 'https://github.com/zephyraluco/olei_driver' },
            // {
            //   type: 'release',
            //   href: 'https://www.npmjs.com/package/rehype-autolink-headings-simple'
            // }
          ]
        },
        {
          name: 'cyclonedds-iox2',
          description:
            '集成了 iceoryx2 插件的 CycloneDDS SDK',
          links: [{ type: 'github', href: 'https://github.com/zephyraluco/cyclonedds-iox2' }]
        }
      ]}
    />
  </Collapse>

  <h2 id='learnings'>Learnings</h2>
  <ProjectSection
    class='my-2'
    projects={[
      {
        name: 'R Learning',
        description: 'Some notes and code about learning R language',
        links: [
          { type: 'github', href: 'https://github.com/cworld1/r-learning' },
          { type: 'site', href: 'https://cworld1.github.io/r-learning' }
        ]
      },
      {
        name: 'CS 213 Learning',
        description: 'Notes, code and experiences for Introduction to Computer Systems course',
        links: [
          {
            type: 'github',
            href: 'https://github.com/zhuozhiyongde/Introduction-To-Computer-System-2023Fall-PKU'
          }
        ]
      }
    ]}
  />

</PageLayout>

<style>
  .sponsorship-card {
    & .sponsorship-card-img {
      opacity: 0.3;
      --un-blur: blur(4px);
      filter: var(--un-blur);
    }

    &:hover {
      & .sponsorship-card-icon {
        opacity: 0;
      }
      & .sponsorship-card-img {
        opacity: 1;
        --un-blur: blur(0);
      }
    }
  }
</style>
