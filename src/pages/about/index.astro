  {/* tools */}
  <h2 id='tools'>Tools</h2>
  <p>目前常用工具如下:</p>
  <ToolSection
    class='mb-5'
    title='AI Assistant'
    tools={[
      {
        name: 'Claude Code',
        description: 'AI Assistant',
        href: 'https://claude.ai/',
        icon: import('@/assets/tools/claude.svg?raw')
      },
      {
        name: 'OpenCode',
        description: 'AI Assistant',
        href: 'https://opencode.ai/',
        icon: import('@/assets/tools/opencode.svg?raw')
      },
      {
        name: 'Copilot',
        description: 'AI Assistant',
        href: 'https://github.com/features/copilot',
        icon: import('@/assets/tools/copilot.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Development'
    tools={[
      {
        name: 'VS Code',
        description: 'IDE',
        href: 'https://code.visualstudio.com/',
        icon: import('@/assets/tools/vscode.svg?raw')
      },
      {
        name: 'Visual Studio',
        description: 'IDE',
        href: 'https://visualstudio.microsoft.com/',
        icon: import('@/assets/tools/visualstudio.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Environment'
    tools={[
      {
        name: 'Windows 11',
        description: 'PC',
        href: 'https://news.microsoft.com/windows11-general-availability/',
        icon: import('@/assets/tools/windows11.svg?raw')
      },
      {
        name: 'Ubuntu 24.04 LTS',
        description: 'Linux Distribution',
        href: 'https://ubuntu.com/',
        icon: import('@/assets/tools/ubuntu.svg?raw')
      },
      {
        name: 'MacOS Tahoe',
        description: 'MacBook Air',
        href: 'https://www.apple.com/macos/',
        icon: import('@/assets/tools/apple.svg?raw')
      }
    ]}
  />

  {/* social-networks */}
  <h2 id='social-networks'>Social Networks</h2>
  <p>
    主要平台如下:
  </p>
  <Substats
    stats={[
      {
        platform: 'BiliBili',
        icon: 'bilibili',
        link: 'https://space.bilibili.com/366030532',
        text: 'followers',
        api: 'bilibili/366030532'
      },
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/zephyraluco',
        text: 'followers',
        api: 'github/zephyraluco'
      },
      {
        platform: 'Steam',
        icon: 'steam',
        color: '#50769d',
        link: 'https://steamcommunity.com/id/zephyraluco',
        text: 'games',
        api: 'steamgames/76561198985601100'
      }
    ]}
  />

  {/* special links */}
  <h2 id='special-links'>Special Links</h2>
  <LinkList list={links.special} />

