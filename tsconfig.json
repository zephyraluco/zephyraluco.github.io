{
  "extends": "astro/tsconfigs/strict",
  "include": ["./.astro/types.d.ts", "./**/*"],
  "compilerOptions": {
    // Basic
    "allowJs": true,
    // Building for a library
    "declaration": true,
    // Code runs in the DOM
    "lib": ["es2022", "dom", "dom.iterable"],
    // Type Imports
    "verbatimModuleSyntax": true,
    // Others
    "strictNullChecks": true,
    // Paths
    "paths": {
      "@/assets/*": ["./src/assets/*"],
      "@/public/*": ["./public/*"],
      "@/components/*": ["./src/components/*"],
      "@/layouts/*": ["./src/layouts/*"],
      "@/plugins/*": ["./src/plugins/*"],
      "@/pages/*": ["./src/pages/*"],
      "@/types": ["./src/types/site.ts"],
      "@/site-config": ["./src/config/index.ts"],
      "@/lib/*": ["./src/lib/*"],
      "@/config/*": ["./src/config/*"]
    }
  },
  "exclude": [
    "./node_modules",
    "./**/node_modules/*",
    "./.vscode",
    "./dist",
    "./public/scripts/*",
    "./test/*"
  ]
}
