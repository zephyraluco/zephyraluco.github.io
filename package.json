{
  "name": "zeal-lab",
  "type": "module",
  "version": "4.1.6",
  "scripts": {
    "dev": "astro dev",
    "dev:check": "bun run --cwd tools/quality check --watch & astro dev",
    "build": "bun run check && astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro sync && tsc --noEmit && bun run check:astro",
    "astro": "astro",
    "format": "prettier --write  '**/*.{js,jsx,ts,tsx,md,astro}'",
    "lint": "bun run --cwd tools/quality lint",
    "yijiansilian": "bun lint && bun sync && bun check && bun format",
    "clean": "rm -rf .astro .vercel dist",
    "new:post": "node scripts/new-post.mjs",
    "test": "bun test tests/unit",
    "test:e2e": "playwright test",
    "lint:fix": "bun run --cwd tools/quality lint:fix",
    "check:astro": "bun run --cwd tools/quality check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.8",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@pagefind/default-ui": "1.5.2",
    "@shikijs/core": "4.6.0",
    "@unocss/astro": "66.13.0",
    "@unocss/reset": "66.13.0",
    "@waline/client": "^3.16.2",
    "astro": "7.4.11",
    "hastscript": "9.0.1",
    "katex": "^0.16.47",
    "medium-zoom": "^1.1.2",
    "mermaid": "^12.3.0",
    "pagefind": "1.5.2",
    "panzoom": "^9.4.4",
    "qrcode": "^1.5.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "shiki": "4.6.0",
    "typescript": "7.0.2",
    "ultrahtml": "1.6.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "unocss": "66.13.0",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.65.0",
    "@shikijs/types": "4.6.0",
    "@types/bun": "^1.4.4",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@unocss/preset-typography": "66.13.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2"
  },
  "private": true,
  "workspaces": [
    "tools/quality"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@types/hast": "3.0.5"
  }
}
